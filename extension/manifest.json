{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/index.js"]
  }],
  "action": {
    "default_popup": "public/popup.html"
  }
}