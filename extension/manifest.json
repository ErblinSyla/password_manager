{
  "manifest_version": 3,
  "name": "TrueLock",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon16.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs",
    "windows",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module",
    "scripts": ["src/background/index.js"]
  },

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/index.js"],
    "all_frames": true,
    "match_about_blank": true
  }],

  "action": {
    "default_popup": "public/popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "password-manager@localhost",
      "strict_min_version": "109.0"
    }
  }
}